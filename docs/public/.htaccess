# Apache 2.4+ 静态部署规则（适用于 VitePress cleanUrls + fanqiangtizi.cc）
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .md .xml .json .html
Options -Indexes +FollowSymLinks
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 统一主域（www -> 裸域）并强制 HTTPS（本地 localhost 测试环境除外）
  RewriteCond %{HTTP_HOST} ^www\.fanqiangtizi\.cc$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^ https://fanqiangtizi.cc%{REQUEST_URI} [L,R=301]

  # 2. 统一去掉 index.html 尾缀避免重复收录
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

  # 3. 若显式请求 .html（排除真实存在的 404.html），规范重定向到无后缀 cleanUrl
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # 4. 目录首页优先直接命中真实存在的 directory/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ $1/index.html [L]

  # 5. 若请求的是干净路径（如 /brands/guangsuyun），映射到对应静态 .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 6. 禁止把未知 URL 重写到首页：未命中真实文件/目录时交由 Apache 返回真实 HTTP 404
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/rss+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>
